<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.fons.cloud.ai</groupId>
    <artifactId>fons4ai-rag2okf-service</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>Fons4AI Rag2OKF Service</name>
    <description>Rag2OKF 后端服务</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-boot.version>3.5.8</spring-boot.version>
        <fons4cloud.version>1.0.0</fons4cloud.version>
        <fons4ai.version>1.0.0</fons4ai.version>
        <fastjson2.version>2.0.42</fastjson2.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>com.alibaba.fastjson2</groupId>
            <artifactId>fastjson2</artifactId>
            <version>${fastjson2.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>com.fons.cloud</groupId>
            <artifactId>fons4cloud-auth-satoken</artifactId>
            <version>${fons4cloud.version}</version>
        </dependency>

        <dependency>
            <groupId>com.fons.cloud</groupId>
            <artifactId>fons4cloud-common-lock</artifactId>
            <version>${fons4cloud.version}</version>
        </dependency>

        <dependency>
            <groupId>com.fons.cloud</groupId>
            <artifactId>fons4cloud-common-skywalking</artifactId>
            <version>${fons4cloud.version}</version>
        </dependency>

        <dependency>
            <groupId>com.fons.cloud</groupId>
            <artifactId>fons4cloud-common-db-datasource</artifactId>
            <version>${fons4cloud.version}</version>
        </dependency>

        <dependency>
            <groupId>com.fons.cloud</groupId>
            <artifactId>fons4cloud-common-elasticsearch</artifactId>
            <version>${fons4cloud.version}</version>
        </dependency>

        <dependency>
            <groupId>com.fons.cloud</groupId>
            <artifactId>fons4cloud-common-file</artifactId>
            <version>${fons4cloud.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <dependency>
            <groupId>com.fons.cloud.ai</groupId>
            <artifactId>fons4ai-agent-langchain-starter</artifactId>
            <version>${fons4ai.version}</version>
        </dependency>

        <dependency>
            <groupId>com.fons.cloud.ai</groupId>
            <artifactId>fons4ai-rag-langchain-starter</artifactId>
            <version>${fons4ai.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- T031/T004：只在隔离 MySQL 容器中验证初始化 SQL 和持久化契约。 -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>mysql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>fons4ai-rag2okf-service</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.1</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
